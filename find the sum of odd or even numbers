import java.util.*;

public class Main {
    public static void main(String[] args) {
      System.out.println("Hello, World!");

      Scanner scan=new Scanner(System.in); 
     System.out.println("Enter a number :");
     int n=scan.nextInt();

      int e=0;
      int m=0;
     
      for(int i=0;i<=n;i++)
      {
       if(i%2==0)
       {    e+=i;
          }
      else {
          m+=i;
        }
      }
      System.out.println("Even:"+e);
       System.out.println("odd:"+m);
      }
    }
