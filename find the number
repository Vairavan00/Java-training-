import java.util.*;

public class Main {
    public static void main(String[] args) {
      System.out.println("Hello, World!");

      Scanner scan=new Scanner(System.in); 
     System.out.println("Enter a number :");
     int n=scan.nextInt();
     int sum=0;
     for(int i=0;i<=n;i++)
     {
      if(i%3==0)
        sum+=i;
     }
       System.out.println("sum of the number :"+sum);
     
    }
}
